# Demo pública -- ver README.md. Credenciais reais de uma conta de teste
# (descartável, criada só pra esta demo) estão lá -- copie de lá pra cá,
# ou copie este arquivo pra .env e cole os valores.

# ---------------------------------------------------------------------
# Postgres -- local, sobe pelo próprio docker-compose.yml (serviço "db").
# Não precisa criar conta em lugar nenhum, nem mudar isso.
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://garmin_demo:garmin_demo@db:5432/garmin_demo

# ---------------------------------------------------------------------
# Garmin -- mockado por padrão (ver GARMIN_MOCK abaixo). Não precisa de
# conta pra rodar a demo.
# ---------------------------------------------------------------------
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_MOCK=true

# ---------------------------------------------------------------------
# Seed sintético (scripts/seed_demo.py) -- controla quais guardrails a
# semana mais recente dispara. Ver docstring do script.
# ---------------------------------------------------------------------
SEED_CENARIO=ambos

# ---------------------------------------------------------------------
# LLM -- "mock" nunca falha, não baixa nada, plano pré-gravado reagindo
# aos guardrails. "ollama" gera o plano de verdade, local, sem custo (ver
# README pra baixar o modelo antes de trocar pra ele). "gemini" é o
# comportamento real do projeto original, exige GEMINI_API_KEY própria.
# ---------------------------------------------------------------------
LLM_PROVEDOR=mock
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
GEMINI_API_KEY=
GEMINI_MODEL=

# ---------------------------------------------------------------------
# Google Sheets -- real (não mockado). Credenciais da conta de teste no
# README.md.
# ---------------------------------------------------------------------
GOOGLE_SHEETS_CREDENTIALS_PATH=.google_sheets_credentials.json
GOOGLE_SHEET_ID=

# ---------------------------------------------------------------------
# E-mail (Gmail SMTP) -- real (não mockado). Credenciais da conta de
# teste no README.md.
# ---------------------------------------------------------------------
EMAIL_REMETENTE=
EMAIL_SENHA_APP=
EMAIL_DESTINATARIO=
